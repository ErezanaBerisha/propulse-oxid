{% include "headitem.html.twig" with {title: "STATHUBS_TITLE"|translate, box: "box"} %}

<style>{{ stathubsCss|raw }}</style>

<div class="stathubs-layout">
    <section class="stathubs-card">
        <h1>{{ translate({ ident: "STATHUBS_TITLE" }) }}</h1>
        <p class="stathubs-help">{{ translate({ ident: "STATHUBS_HELP" }) }}</p>

        <label class="stathubs-field" for="stathubs-shop-url">
            <span>{{ translate({ ident: "STATHUBS_SHOP_URL" }) }}</span>
            <span class="stathubs-field__row">
                <input type="text" readonly="readonly" id="stathubs-shop-url" value="{{ stathubsShopUrl }}">
                <button type="button" class="stathubs-copy" data-target="stathubs-shop-url">{{ translate({ ident: "STATHUBS_COPY" }) }}</button>
            </span>
        </label>

        <label class="stathubs-field" for="stathubs-email">
            <span>{{ translate({ ident: "STATHUBS_EMAIL" }) }}</span>
            <span class="stathubs-field__row">
                <input type="text" readonly="readonly" id="stathubs-email" value="{{ stathubsEmail }}">
                <button type="button" class="stathubs-copy" data-target="stathubs-email">{{ translate({ ident: "STATHUBS_COPY" }) }}</button>
            </span>
        </label>

        <label class="stathubs-field" for="stathubs-password">
            <span>{{ translate({ ident: "STATHUBS_PASSWORD" }) }}</span>
            <span class="stathubs-field__row">
                <input type="text" readonly="readonly" id="stathubs-password" value="{{ stathubsPassword }}">
                <button type="button" class="stathubs-copy" data-target="stathubs-password">{{ translate({ ident: "STATHUBS_COPY" }) }}</button>
            </span>
        </label>

        <p class="stathubs-help">{{ translate({ ident: "STATHUBS_QR_HELP" }) }}</p>
        <div
            id="stathubs-qr"
            class="stathubs-qr"
            data-email="{{ stathubsEmail }}"
            data-password="{{ stathubsPassword }}"
            data-shop-url="{{ stathubsShopUrl }}"
            data-platform-type="{{ stathubsPlatformType }}"
            data-copied="{{ translate({ ident: "STATHUBS_COPIED" }) }}"
        ></div>
    </section>

    <section class="stathubs-card">
        <h2>{{ translate({ ident: "STATHUBS_PERMISSIONS" }) }}</h2>
        <p><strong>{{ translate({ ident: "STATHUBS_VIEW_ONLY" }) }}</strong></p>
        <p class="stathubs-help">{{ translate({ ident: "STATHUBS_PERMISSIONS_HELP" }) }}</p>
    </section>
</div>

<script>{{ stathubsQrJs|raw }}</script>
<script>{{ stathubsAdminJs|raw }}</script>

{% include "bottomitem.html.twig" %}
