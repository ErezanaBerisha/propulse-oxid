{% include "headitem.html.twig" with {title: "PROPULSE_TITLE"|translate, box: "box"} %}

<style>{{ propulseCss|raw }}</style>

<div class="propulse-layout">
    <section class="propulse-card">
        <h1>{{ translate({ ident: "PROPULSE_TITLE" }) }}</h1>
        <p class="propulse-help">{{ translate({ ident: "PROPULSE_HELP" }) }}</p>

        <label class="propulse-field" for="propulse-shop-url">
            <span>{{ translate({ ident: "PROPULSE_SHOP_URL" }) }}</span>
            <span class="propulse-field__row">
                <input type="text" readonly="readonly" id="propulse-shop-url" value="{{ propulseShopUrl }}">
                <button type="button" class="propulse-copy" data-target="propulse-shop-url">{{ translate({ ident: "PROPULSE_COPY" }) }}</button>
            </span>
        </label>

        <label class="propulse-field" for="propulse-email">
            <span>{{ translate({ ident: "PROPULSE_EMAIL" }) }}</span>
            <span class="propulse-field__row">
                <input type="text" readonly="readonly" id="propulse-email" value="{{ propulseEmail }}">
                <button type="button" class="propulse-copy" data-target="propulse-email">{{ translate({ ident: "PROPULSE_COPY" }) }}</button>
            </span>
        </label>

        <label class="propulse-field" for="propulse-password">
            <span>{{ translate({ ident: "PROPULSE_PASSWORD" }) }}</span>
            <span class="propulse-field__row">
                <input type="text" readonly="readonly" id="propulse-password" value="{{ propulsePassword }}">
                <button type="button" class="propulse-copy" data-target="propulse-password">{{ translate({ ident: "PROPULSE_COPY" }) }}</button>
            </span>
        </label>

        <p class="propulse-help">{{ translate({ ident: "PROPULSE_QR_HELP" }) }}</p>
        <div
            id="propulse-qr"
            class="propulse-qr"
            data-email="{{ propulseEmail }}"
            data-password="{{ propulsePassword }}"
            data-shop-url="{{ propulseShopUrl }}"
            data-platform-type="{{ propulsePlatformType }}"
            data-copied="{{ translate({ ident: "PROPULSE_COPIED" }) }}"
        ></div>
    </section>

    <section class="propulse-card">
        <h2>{{ translate({ ident: "PROPULSE_PERMISSIONS" }) }}</h2>
        <p><strong>{{ translate({ ident: "PROPULSE_VIEW_ONLY" }) }}</strong></p>
        <p class="propulse-help">{{ translate({ ident: "PROPULSE_PERMISSIONS_HELP" }) }}</p>
    </section>
</div>

<script>{{ propulseQrJs|raw }}</script>
<script>{{ propulseAdminJs|raw }}</script>

{% include "bottomitem.html.twig" %}
